# Dependencies (recreated via npm install from package.json / package-lock.json)
node_modules/

# Production build output (generated by npm run build / Vercel)
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & secret files (never commit API keys or secrets!)
.env
.env.*
!.env.example

# Editor & OS junk files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json